# Copier en .env.local et renseigner les valeurs.

# URL publique du site (optionnel) — liens absolus éventuels. La carte cadeau
# dans les emails est désormais jointe en image (CID), donc cette variable n'est
# pas nécessaire pour les emails. En prod : l'URL réelle du déploiement.
NEXT_PUBLIC_SITE_URL=

# Compte admin (login sans base de données)
ADMIN_EMAIL=hello@articafeceramique.fr
ADMIN_PASSWORD=change-me

# Secret de signature des JWT (générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me

# Base MongoDB. En prod : URI MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/template-cms

# Stripe (paiement). Privé — ne jamais committer les vraies valeurs.
# Tant que STRIPE_SECRET_KEY est vide, les cartes cadeaux tournent en mode test.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook (filet anti-paiement-orphelin). En prod :
# déclarer l'endpoint POST /api/gift-cards/webhook dans le dashboard Stripe
# (event payment_intent.succeeded). En local : `stripe listen --forward-to
# localhost:3000/api/gift-cards/webhook` fournit ce whsec_...
STRIPE_WEBHOOK_SECRET=

# Resend (emails transactionnels). Si vide, les emails sont désactivés.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ARTI <noreply@articafeceramique.fr>
