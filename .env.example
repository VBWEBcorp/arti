# Copier en .env.local et renseigner les valeurs.

# Compte admin (login sans base de données)
ADMIN_EMAIL=hello@articafeceramique.fr
ADMIN_PASSWORD=change-me

# Secret de signature des JWT (générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me

# Base MongoDB. En prod : URI MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/template-cms
